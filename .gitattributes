# Native authoring files and source previews use ordinary Git.
*.blend binary
*.png binary
*.glb binary

# Shared optional runtime artwork. Content packs and build output remain ignored.
/assets/open-models/**/*.glb filter=lfs diff=lfs merge=lfs -text
