        "evolution_design": {
          "regional_evidence": "MNHS records the agropelter hiding in hollow trees near trails and throwing dead branches; accounts describe a small mean face but leave its overall body uncertain.",
          "original_invention": "The knotted seed shape, hollow chest, spring forearms and three-stage anatomy are original inventions, not an illustration claimed from the historical source.",
          "body_growth": [
            {
              "species_id": "MN_169",
              "body": "A hollow knot creature with a tiny face peering from one deep side opening; two bent branch forearms fold below the round chest and root toes grip the trail edge.",
              "silhouette": "Round hollow knot, small bent arms and two root feet."
            },
            {
              "species_id": "MN_170",
              "body": "The central knot splits vertically into a hollow wooden ribcage. One large bent arm curves above the shoulder and the other braces forward, producing an uneven ready-to-throw pose.",
              "silhouette": "Open split trunk with one raised bow-arm and one long bracing arm."
            },
            {
              "species_id": "MN_171",
              "body": "A powerful squat branch-spring brawler with two enormous bowed arms attached by round growth joints, a hollow barrel chest and a low face tucked under a thick brow. Short stump legs keep the silhouette grounded.",
              "silhouette": "Wide low brawler framed by two great asymmetric bowed arms; one large chest hollow, no held club."
            }
          ]
        },
        "silhouette_concept": "Round hollow knot, small bent arms and two root feet. \u2192 Open split trunk with one raised bow-arm and one long bracing arm. \u2192 Wide low brawler framed by two great asymmetric bowed arms; one large chest hollow, no held club.",
        "habitat": "Second-growth hollow trees above North Shore portage trails.",
        "proposed_routes": [
          {
            "id": "MN_R12",
            "placement": "Windthrow district forest edge and optional deadwood pocket, keeping the navigation path readable.",
            "status": "encounter proposal only; no map or story mutation"
          }
        ],
        "sources": [
          {
            "title": "Marjorie Edgar, Imaginary Animals of Northern Minnesota, Minnesota History21(4),1940,pp353\u2013356",
            "url": "https://storage.googleapis.com/mnhs-org-support/mn_history_articles/21/v21i04p353-356.pdf",
            "supports": "Historical logging-camp tall tales collected on the North Shore; each family notes the limited source anatomy.",
            "source_kind": "primary historical field recollection"
          }
        ],
        "nonduplication": "Unlike haunted axeF017, there is no blade or possessed tool; unlike F068 scarecrow, no human figure or crop guardian. Power comes from grown branch springs and a hollow chest.",
