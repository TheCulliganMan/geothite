    "register_lines": [
      "RANGER: Going",
      "round the loop?",
      "Cross RAINY RIVER",
      "and follow the",
      "VOYAGEURS shore",
      "east to BOUNDARY",
      "WATERS. The west",
      "watch there will",
      "call when they see",
      "you. Come back",
      "here when you're",
      "done. Shall I put",
      "your name down?"
    ],
    "registered_lines": [
      "RANGER: I've got",
      "your name. Before",
      "you go out, the",
      "crossing warden",
      "still needs eight",
      "BADGES and the all",
      "clear from DULUTH",
      "harbor."
    ],
    "waiting_lines": [
      "RANGER: I haven't",
      "heard from the",
      "west watch yet.",
      "Follow the",
      "VOYAGEURS shore",
      "east until you",
      "reach their post",
      "in BOUNDARY",
      "WATERS. Then come",
      "back here."
    ],
    "complete_lines": [
      "RANGER: The west",
      "watch called when",
      "you came through.",
      "I left your name",
      "in the book till I",
      "saw you walk back",
      "in. Here you are.",
      "Sit by the stove",
      "while I cross it",
      "off."
    ],
    "reward_lines": [
      "RANGER: Take a PP",
      "UP. Use it on a",
      "move you keep",
      "running out of.",
      "It'll raise the PP",
      "limit. I keep one",
      "for the team that",
      "goes out to look",
      "for late hikers."
    ],
    "full_lines": [
      "RANGER: Your",
      "PACK's full. I'll",
      "leave the PP UP",
      "beside the book.",
      "Come see me when",
      "you've made room."
    ],
    "repeat_lines": [
      "RANGER: You're",
      "marked back. I",
      "leave the names in",
      "the book till the",
      "next watch has",
      "seen them. Sit by",
      "the stove if",
      "you're staying",
      "awhile."
    ],
    "badge_lines": [
      "RANGER: Before I",
      "can sign you in, I",
      "need to see your",
      "PINE BADGE. Ask",
      "for ORLIS at the",
      "BEMIDJI GYM."
    ],
    "decline_lines": [
      "RANGER: All right.",
